# 生产环境变量：复制成 deploy/.env 后填值，不要提交到 git
# 数据库与缓存
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# 对外地址（用于卡片/图片链接与 Caddy 证书）
PUBLIC_BASE_URL=https://your-domain.example
DOMAIN=your-domain.example
APP_PORT=8090

# 邮件（验证码）：QQ/163 等 SMTP 授权码；留空则验证码只写本地 Redis
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# 秒杀对账周期（秒）：Redis 库存与一人一单集合向 MySQL 收敛
RECONCILE_INTERVAL_SECONDS=300

# 模型：provider 可选 anthropic / deepseek 等，按 llm.py 支持的名称填
XIANGKOU_LLM_PROVIDER=anthropic
XIANGKOU_LLM_API_KEY=
XIANGKOU_LLM_MODEL=
XIANGKOU_LLM_BASE_URL=

# 商家券管理白名单（逗号分隔的用户 id）
XIANGKOU_CATALOG_ADMIN_IDS=

# 镜像名（部署脚本会用 GHCR 地址覆盖）
APP_IMAGE=xiangkou-app:local
GO_IMAGE=xiangkou-go:local
