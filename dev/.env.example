# 供 dev/docker-compose.yml 做变量替换使用（Docker Compose 会读本目录的 .env）。
# 复制成 dev/.env 后填写，dev/.env 已被 .gitignore 忽略，不会进仓库。
#
# 发件邮箱：用 QQ 邮箱 / 163 / Gmail 的「SMTP 授权码」，不是登录密码。
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 生成授权码。
SPRING_MAIL_USERNAME=your-mail@example.com
SPRING_MAIL_PASSWORD=your-smtp-authorization-code

# 以下可选，留空则用 compose 里的默认值
# MYSQL_ROOT_PASSWORD=xiangkou_local_only
# SPRING_DATASOURCE_PASSWORD=xiangkou_local_only
# XIANGKOU_CATALOG_ADMIN_IDS=1010,1012
