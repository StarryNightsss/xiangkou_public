# 点评业务后端（Go）地址，不是 Nginx /api 地址
DIANPING_BASE_URL=http://127.0.0.1:8081
# 点评前端地址，用于生成可点击的店铺链接
DIANPING_WEB_URL=http://127.0.0.1:8080
# 持久化 SQLite 文件；默认 xiangkou/data/xiangkou.sqlite3。停服务后连同 WAL 文件备份。
XIANGKOU_DATA_PATH=
# 可选：anthropic/openai/gemini/deepseek/qwen/kimi/zhipu/openai-compatible
# 不设置 Key 时使用本地规则。配置 Key 时必须填写模型 ID。
XIANGKOU_LLM_PROVIDER=anthropic
XIANGKOU_LLM_MODEL=
XIANGKOU_LLM_API_KEY=
# 留空使用所选供应商的默认 API 地址；自定义兼容服务必须填写。
XIANGKOU_LLM_BASE_URL=
XIANGKOU_LLM_TIMEOUT=12
# 也可使用供应商标准变量，如 ANTHROPIC_API_KEY、OPENAI_API_KEY、GEMINI_API_KEY、
# DEEPSEEK_API_KEY、DASHSCOPE_API_KEY、MOONSHOT_API_KEY、ZHIPU_API_KEY。

# 本地演示商品管理账号（go-api 需配置相同白名单；默认无权限）
XIANGKOU_CATALOG_ADMIN_IDS=

# 邮箱验证码（QQ/163 的 SMTP 授权码，不是登录密码）；留空则只写 Redis
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=